                pokemon: "리자몽 (Charizard)",
                emoji: "🔥",
                reason: "당당한 열정과 강한 승부욕으로 목표를 향해 끝없이 도전합니다.\n명확한 비전과 강력한 카리스마로 팀을 이끄는 타고난 리더입니다.",
                matchMbti: "INTP",
                matchPoke: "잠만보 (Snorlax)",
                matchEmoji: "🐻",
                matchDesc: "앞만 보고 달리는 리자몽에게 잠만보의 여유로움과 명석함은 최고의 조력입니다."
            }
        };

        // Initialize MBTI Choice Grid
        window.onload = function() {
            const mbtiGrid = document.getElementById('mbtiGrid');
            const types = Object.keys(mbtiPokemonData);

            types.forEach(type => {
                const button = document.createElement('button');
                button.className = `p-3.5 sm:p-4 rounded-2xl bg-amber-50 hover:bg-warmYellow active:scale-95 border-2 border-amber-200 
                                    transition duration-200 flex flex-col items-center justify-center shadow-sm hover:shadow-md group`;
                
                button.onclick = () => selectMbti(type);

                button.innerHTML = `
                    <span class="font-jua text-xl sm:text-2xl text-darkText group-hover:scale-110 transition duration-200">${type}</span>
                    <span class="text-xs text-amber-700 font-semibold mt-1 opacity-80">${mbtiPokemonData[type].pokemon.split(' ')[0]}</span>
                `;

                mbtiGrid.appendChild(button);
            });
        };

        // Function triggered on selecting an MBTI type
        function selectMbti(mbti) {
            const data = mbtiPokemonData[mbti];
            if (!data) return;

            // Populate Selection Result Details
            document.getElementById('resMbti').innerText = mbti;
            document.getElementById('resTagline').innerText = `"${data.tagline}"`;
            document.getElementById('resPokeName').innerText = data.pokemon;
            document.getElementById('resEmoji').innerText = data.emoji;
            document.getElementById('resReason').innerText = data.reason;

            // Populate Compatibility Info
            document.getElementById('resMatchMbti').innerText = `BEST: ${data.matchMbti}`;
            document.getElementById('resMatchPoke').innerText = data.matchPoke;
            document.getElementById('resMatchEmoji').innerText = data.matchEmoji;
            document.getElementById('resMatchDesc').innerText = data.matchDesc;

            // View Switching with smooth transition
            const selectionView = document.getElementById('selectionView');
            const resultView = document.getElementById('resultView');

            selectionView.classList.add('hidden');
            resultView.classList.remove('hidden');

            // Scroll gently to top of card on mobile
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Reset Selection to choose another MBTI
        function resetSelection() {
            const selectionView = document.getElementById('selectionView');
            const resultView = document.getElementById('resultView');

            resultView.classList.add('hidden');
            selectionView.classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
