            background-position: 0 0, 30px 30px;
        }

        .font-jua {
            font-family: 'Jua', sans-serif;
        }

        /* Custom Bounce & Fade Animations */
        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.9) translateY(20px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }

        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); box-shadow: 0 10px 25px -5px rgba(255, 200, 50, 0.4); }
            50% { transform: scale(1.03); box-shadow: 0 15px 35px -5px rgba(255, 180, 0, 0.6); }
        }

        .animate-pop {
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        .animate-glow {
            animation: pulseGlow 2.5s infinite;
        }

        /* PokeBall Motif Background Decoration */
        .pokeball-bg {
            background: linear-gradient(180deg, #FF6B6B 45%, #4A3E3D 45%, #4A3E3D 55%, #FFFFFF 55%);
            border-radius: 50%;
            position: relative;
        }

        .pokeball-bg::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 30%;
            height: 30%;
            background: white;
            border: 4px solid #4A3E3D;
            border-radius: 50%;
